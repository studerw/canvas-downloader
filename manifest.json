{
  "manifest_version": 3,
  "name": "Canvas Lecture Downloader",
  "version": "1.1.0",
  "description": "Download Panopto lecture videos and PDF slides from Canvas courses, with automatic university site detection.",
  "permissions": [
    "downloads",
    "scripting"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://*/courses/*",
        "*://*/files/*",
        "*://*/*/courses/*",
        "*://*/*/files/*"
      ],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  }
}
